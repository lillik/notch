{
    "name": "shorturl/app",
    "description": "URL shortener API and click worker",
    "type": "project",
    "require": {
        "php": "^8.3",
        "php-amqplib/php-amqplib": "^3.7",
        "php-di/php-di": "^7.0",
        "predis/predis": "^2.3",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15",
        "zircote/swagger-php": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "openapi": "php bin/openapi.php"
    },
    "config": {
        "platform": {
            "php": "8.3.27"
        }
    }
}
