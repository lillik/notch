# In-network URLs used by the API and the worker.
DATABASE_URL=postgresql://shorturl:shorturl@postgres:5432/shorturl
DATABASE_REPLICA_URL=postgresql://shorturl:shorturl@postgres-replica:5432/shorturl
REDIS_ADDR=redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
PUBLIC_BASE_URL=http://localhost:8080

# Host ports published by compose.yaml:
# nginx 8080, postgres primary 5432, postgres replica 5433, redis 6379, rabbitmq 5672 and 15672
