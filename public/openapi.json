{
    "openapi": "3.0.0",
    "info": {
        "title": "Short URL",
        "description": "Anonymous URL shortener. Create returns a code. Redirect sends the browser to the long URL. Response bodies follow the Accept header: application/json or application/xml. The default is JSON.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Current host"
        }
    ],
    "paths": {
        "/links": {
            "post": {
                "summary": "Create a short link",
                "operationId": "createLink",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Accept"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateLink"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Short link created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CreatedLink"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/CreatedLink"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The URL or expiry is invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "406": {
                        "description": "Accept is neither JSON nor XML"
                    },
                    "429": {
                        "description": "Too many create requests from this address",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/shorten": {
            "post": {
                "summary": "Create a short link",
                "description": "Same operation as POST /links.",
                "operationId": "createLinkAlias",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Accept"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateLink"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Short link created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CreatedLink"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/CreatedLink"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The URL or expiry is invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "406": {
                        "description": "Accept is neither JSON nor XML"
                    },
                    "429": {
                        "description": "Too many create requests from this address",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "summary": "Report whether Postgres and Redis answer",
                "operationId": "health",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Accept"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Dependencies answer",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        }
                    },
                    "406": {
                        "description": "Accept is neither JSON nor XML"
                    },
                    "503": {
                        "description": "A dependency is down",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/{code}": {
            "get": {
                "summary": "Redirect to the long URL",
                "operationId": "redirect",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Accept"
                    },
                    {
                        "name": "code",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9A-Za-z]{1,16}$"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Browser redirect to the long URL",
                        "headers": {
                            "Location": {
                                "required": true,
                                "schema": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "example": "no-store"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown code",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "406": {
                        "description": "Accept is neither JSON nor XML"
                    },
                    "410": {
                        "description": "The link has expired",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            },
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CreateLink": {
                "required": [
                    "long_url"
                ],
                "properties": {
                    "long_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/docs"
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "CreatedLink": {
                "required": [
                    "code",
                    "long_url",
                    "short_url"
                ],
                "properties": {
                    "code": {
                        "type": "string",
                        "example": "100012V"
                    },
                    "long_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "short_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ErrorResponse": {
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "Health": {
                "required": [
                    "status"
                ],
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "ok",
                            "down"
                        ]
                    }
                },
                "type": "object"
            }
        },
        "parameters": {
            "Accept": {
                "name": "Accept",
                "in": "header",
                "description": "Response format. Defaults to application/json.",
                "required": false,
                "schema": {
                    "type": "string",
                    "default": "application/json",
                    "enum": [
                        "application/json",
                        "application/xml"
                    ]
                }
            }
        }
    }
}
